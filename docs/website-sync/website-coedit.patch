+      sectionTabs.forEach((btn) => {
+        btn.addEventListener("click", () => {
+          clearInterval(timer);
+          showSection(btn.dataset.sectionTab);
+          if (auto) startTour();
+        });
+      });
+
+      $$("[data-surf]").forEach((btn) => {
+        btn.addEventListener("click", () => {
+          clearInterval(timer);
+          showSurf(Number(btn.dataset.surf));
+          if (auto) startTour();
+        });
+      });
+
+      $$("[data-lang]").forEach((btn) => {
+        btn.addEventListener("click", () => {
