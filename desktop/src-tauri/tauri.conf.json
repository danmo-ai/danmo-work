{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Danmo Work",
  "version": "0.9.17",
  "identifier": "com.danmo.work",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://localhost:5801/",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "frontendDist": "../../out/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Danmo Work",
        "width": 1280,
        "height": 800,
        "titleBarStyle": "Visible",
        "url": "/",
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/danmo-work-backend"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NjFEOUQ3RUQzQkNEOUUKUldTZXpUdnQxOWxocHdya3Y3OVhXTzRESUV3WVc3enZwcUsvTkNQZTRJaUppNmNkdjJrYTMvbksK",
      "endpoints": [
        "https://releases.danmo.ai/danmo-work/latest.json",
        "https://gitee.com/danmo-ai/danmo-work/raw/updater/latest.json",
        "https://github.com/danmo-ai/danmo-work/releases/latest/download/latest.json"
      ]
    }
  }
}
