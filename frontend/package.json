{
  "name": "danmo-work-frontend",
  "private": true,
  "version": "0.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:markdown": "node --experimental-strip-types scripts/test-tiptap-markdown.mjs",
    "test:slides": "node --import ./scripts/register-ts-resolve.mjs --experimental-strip-types scripts/test-slides-render.mjs",
    "test:code-route": "node --experimental-strip-types scripts/test-code-route.mjs",
    "check-i18n": "NODE_ENV=production node --experimental-strip-types scripts/check-i18n.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@danqing/dq-shell": "file:../../dq-ui/packages/shell",
    "@danqing/dq-tokens": "file:../../dq-ui/packages/tokens",
    "@danqing/dq-ui": "file:../../dq-ui/packages/ui",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "3.29.0",
    "@tiptap/extensions": "3.29.0",
    "@tiptap/markdown": "3.29.0",
    "@tiptap/pm": "3.29.0",
    "@tiptap/starter-kit": "3.29.0",
    "@tiptap/vue-3": "3.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
